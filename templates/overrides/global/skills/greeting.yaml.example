# Пример заменяет нейтральный greeting локальным динамическим приветствием.
target: greeting
override:
  # replace использует каталог примера вместо поставляемой реализации skill.
  mode: replace
  value:
    # Относительный путь остаётся переносимым внутри локального хранилища.
    path: ../../examples/greeting
