# Локальные credentials для stdio MCP. Заполненный файл не коммитьте.
GITHUB_PERSONAL_ACCESS_TOKEN=
# Self-managed GitLab MCP endpoint, например https://gitlab.company.example/api/v4/mcp.
GITLAB_MCP_URL=
# Необязательный персональный Context7 API key увеличивает лимиты запросов документации.
CONTEXT7_API_KEY=
# Self-hosted Sentry hostname без протокола, например sentry.company.example.
SENTRY_ACCESS_TOKEN=
SENTRY_HOST=
# Self-hosted SonarQube требует полный HTTPS URL и персональный token.
SONARQUBE_URL=https://sonarqube.company.example
SONARQUBE_TOKEN=

# Jira Data Center: hostname без протокола и персональный API token.
JIRA_HOST=
JIRA_API_TOKEN=
# Confluence Data Center: hostname без протокола и персональный API token.
CONFLUENCE_HOST=
CONFLUENCE_API_TOKEN=
