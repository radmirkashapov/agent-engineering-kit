# Локальные credentials для stdio MCP. Заполненный файл не коммитьте.
GITHUB_PERSONAL_ACCESS_TOKEN=
# Self-managed GitLab MCP endpoint, например https://gitlab.example.ru/api/v4/mcp.
GITLAB_MCP_URL=
# Self-hosted Sentry hostname без протокола, например sentry.dellin.ru.
SENTRY_ACCESS_TOKEN=
SENTRY_HOST=
SONARQUBE_TOKEN=

# Корпоративный Atlassian MCP (Jira и Confluence). OAuth завершается отдельно в каждом client profile.
ATLASSIAN_MCP_URL=
