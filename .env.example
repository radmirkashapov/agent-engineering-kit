# Только имена переменных. Значения secrets храните во внешнем secret store.
GITHUB_PERSONAL_ACCESS_TOKEN=
# Обязательный read-only token для Sentry MCP; значение хранится только локально.
SENTRY_ACCESS_TOKEN=
# Необязательный hostname self-hosted Sentry без протокола, например sentry.company.example.
SENTRY_HOST=
# Для self-managed GitLab укажите полный HTTPS endpoint, например https://gitlab.company.example/api/v4/mcp.
GITLAB_MCP_URL=
SONARQUBE_TOKEN=
SONARQUBE_URL=
ATLASSIAN_SITE_URL=
JIRA_URL=
CONFLUENCE_URL=
