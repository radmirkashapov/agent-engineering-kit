{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-engineering-kit.local/schemas/component-inventory.schema.json",
  "title": "Machine-local discovered component inventory",
  "type": "object",
  "required": ["version", "project_id", "components"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "repository", "path", "type", "dependencies", "evidence", "confidence"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "repository": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "type": {"enum": ["maven", "gradle", "node", "go", "cargo", "dotnet", "python", "bazel", "logical"]},
          "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "confidence": {"enum": ["high", "medium", "low", "declared"]},
          "owner": {"type": "string", "minLength": 1},
          "criticality": {"enum": ["low", "medium", "high", "critical"]}
        }
      }
    }
  }
}
