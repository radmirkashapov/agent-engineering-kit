{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-engineering-kit.local/schemas/agent.schema.json",
  "type": "object",
  "required": ["version", "id", "role", "requires"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "role": { "type": "string", "minLength": 1 },
    "policy": { "enum": ["configurable", "enforced"] },
    "model": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "preferred": { "type": "string" },
        "allowed": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "requires": { "$ref": "#/$defs/requires" },
    "tools": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
  },
  "$defs": {
    "requires": {
      "type": "object", "required": ["model_capabilities"], "additionalProperties": false,
      "properties": { "model_capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } } }
    }
  }
}
