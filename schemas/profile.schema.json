{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-engineering-kit.local/schemas/profile.schema.json",
  "title": "Agent Engineering Kit operator profile",
  "type": "object",
  "required": ["version", "id", "description", "roles", "skills", "mcp", "permissions"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "id": { "enum": ["developer", "tester", "reviewer"] },
    "description": { "type": "string", "minLength": 20 },
    "roles": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "skills": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "mcp": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "permissions": {
      "type": "object",
      "required": ["approval_mode", "sandbox", "network", "tools"],
      "additionalProperties": false,
      "properties": {
        "approval_mode": { "enum": ["readonly", "autonomous", "custom"] },
        "sandbox": { "enum": ["read-only", "workspace-write", "unrestricted"] },
        "network": { "enum": ["deny", "allowlist", "unrestricted"] },
        "tools": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    }
  }
}
