{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "servers"],
  "properties": {
    "version": {"const": 1},
    "catalog_type": {"const": "corporate"},
    "tool_budget": {"type": "integer", "minimum": 1},
    "servers": {"type": "array"}
  },
  "if": {"required": ["catalog_type"]},
  "then": {
    "required": ["tool_budget"],
    "properties": {"servers": {"items": {"$ref": "#/$defs/corporateServer"}}}
  },
  "else": {"properties": {"servers": {"items": {"$ref": "#/$defs/registryServer"}}}},
  "$defs": {
    "registryServer": {
      "type": "object", "required": ["id", "description", "category", "required", "transport", "activation", "source", "installation", "state", "policy"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "description": {"type": "string", "minLength": 20},
        "category": {"enum": ["core", "scm", "quality", "collaboration"]}, "required": {"type": "boolean"},
        "transport": {"enum": ["stdio", "http", "sse"]}, "activation": {"type": "string"}, "command": {"type": "string"},
        "args": {"type": "array", "items": {"type": "string"}}, "source": {"type": "object"}, "installation": {"type": "object"},
        "environment": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^env:[A-Z][A-Z0-9_]*$"}},
        "state": {"enum": ["native", "stateless"]}, "policy": {"enum": ["configurable", "locked"]}
      }
    },
    "corporateServer": {
      "type": "object",
      "required": ["id", "owner", "trust", "data_classes", "auth", "boundaries", "audit", "capabilities"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "owner": {"type": "string", "minLength": 3},
        "trust": {"enum": ["trusted", "restricted"]},
        "data_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["public", "internal", "confidential", "restricted"]}},
        "auth": {"type": "object", "required": ["method"], "additionalProperties": false, "properties": {
          "method": {"enum": ["oauth", "secret-broker", "native-keychain", "environment"]},
          "reference": {"type": "string", "pattern": "^env:[A-Z][A-Z0-9_]*$"}
        }},
        "boundaries": {"type": "object", "required": ["allowed_hosts", "read_only", "model_endpoint"], "additionalProperties": false, "properties": {
          "allowed_hosts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9.-]+$"}},
          "read_only": {"type": "boolean"},
          "model_endpoint": {"enum": ["approved-only", "local-only", "none"]}
        }},
        "audit": {"type": "object", "required": ["decisions", "arguments", "results"], "additionalProperties": false, "properties": {
          "decisions": {"const": true},
          "arguments": {"enum": ["redacted", "metadata-only"]},
          "results": {"enum": ["redacted", "metadata-only"]}
        }},
        "capabilities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/capability"}}
      }
    },
    "capability": {
      "type": "object", "required": ["id", "mode", "tool_cost", "data_classes"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"},
        "mode": {"enum": ["read", "write", "admin"]},
        "tool_cost": {"type": "integer", "minimum": 1},
        "data_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["public", "internal", "confidential", "restricted"]}},
        "conflicts_with": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    }
  }
}
