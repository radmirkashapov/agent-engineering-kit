{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-engineering-kit.local/schemas/project-bindings.schema.json",
  "title": "Machine-local project repository bindings",
  "type": "object",
  "required": ["version", "project_id", "repositories"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
          "path": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
